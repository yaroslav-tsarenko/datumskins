# ============================================================
# Database — Prisma Postgres
# ============================================================

# Prisma Postgres protocol URL (used by Prisma CLI)
DATABASE_URL="prisma+postgres://localhost:51213/?api_key=..."

# Direct PostgreSQL connection (used by app runtime and seed)
DIRECT_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# ============================================================
# Auth
# ============================================================
JWT_SECRET="change-this-to-a-random-secret-in-production"

# ============================================================
# App Config
# ============================================================
NEXT_PUBLIC_SITE_URL="https://www.datumskins.com"

# Public base URL of this deployment. Steam OpenID uses it to build the
# realm and return_to callback, so it MUST match the origin users hit
# (no trailing slash). Locally use http://localhost:9997; in production set
# your real domain, e.g. https://www.datumskins.com. On Vercel, the
# production domain is preferred and VERCEL_URL is only a last-resort fallback.
APP_URL="http://localhost:9997"
NEXT_PUBLIC_APP_URL="http://localhost:9997"

# ============================================================
# Steam
# ============================================================
# Steam Web API key from https://steamcommunity.com/dev/apikey — used to fetch
# player profile summaries (persona name, avatar) after OpenID sign-in. Sign-in
# still works without it, but profiles degrade to a bare SteamID64.
STEAM_API_KEY="your-steam-web-api-key"

# ============================================================
# Cloudflare R2 — Image CDN Storage
# ============================================================
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="your-bucket-name"
R2_PUBLIC_URL="https://pub-xxxxx.r2.dev"

# ============================================================
# Company / legal — surfaced in footer, policies & contact page
# (NEXT_PUBLIC_* so they resolve in client components too)
# ============================================================
NEXT_PUBLIC_COMPANY_LEGAL_NAME="CHANGE IT UP SERVICES LTD"
NEXT_PUBLIC_COMPANY_NUMBER="16107295"
NEXT_PUBLIC_COMPANY_ADDRESS="14 Broadway"
NEXT_PUBLIC_COMPANY_ADDRESS_LINE2=""
NEXT_PUBLIC_COMPANY_CITY="Nottingham"
NEXT_PUBLIC_COMPANY_REGION=""
NEXT_PUBLIC_COMPANY_POSTCODE="NG1 1PS"
NEXT_PUBLIC_COMPANY_COUNTRY="United Kingdom"
NEXT_PUBLIC_CONTACT_EMAIL="info@datumskins.com"
NEXT_PUBLIC_CONTACT_PHONE=""

# ============================================================
# Social Media
# ============================================================
NEXT_PUBLIC_INSTAGRAM_URL="https://www.instagram.com/datumskins/"
NEXT_PUBLIC_LINKEDIN_URL="https://www.linkedin.com/company/datumskins/"

# ============================================================
# Resend — transactional emails
# ============================================================
RESEND_API_KEY="re_xxxxx"
RESEND_FROM_EMAIL="Datumskins <info@ultrasensskin.com>"   # TODO: move to a verified datumskins.com sender in Resend
RESEND_REPLY_TO="info@ultrasensskin.com"

# ============================================================
# SIH Skin Provider (SERVER-ONLY — never expose to the client)
# All calls to api.sih.market happen from server code (route handlers /
# cron). The browser never talks to SIH and never sees SIH_API_KEY.
# ============================================================
# API key sent as the `apikey` header on every SIH request.
SIH_API_KEY=""
SIH_API_BASE="https://api.sih.market/api/v1"
SIH_APP_ID="730"
# Our own secret appended to the SIH webhook URL (?secret=...) so we can verify
# that an incoming webhook actually came from our SIH project configuration.
SIH_WEBHOOK_SECRET=""
# true -> every create-order is sent with test:true (no funds charged). Use for
# smoke tests and staging.
SIH_TEST_MODE="false"
# Allowed price growth between the moment we show a price and the moment we buy
# (fraction; 0.03 = 3%). If SIH's live price grew more than this, we re-confirm.
SIH_PRICE_TOLERANCE="0.03"
# Storefront markup on top of SIH cost (fraction; 0.07 = 7%).
SIH_MARGIN="0.07"
# Minimum absolute margin in USD, so cheap items still earn something.
SIH_MIN_MARGIN_ABS="0.10"
# Catalog sync cadence in minutes (mirror this in vercel.json crons).
SIH_SYNC_INTERVAL_MIN="7"
# Alert threshold (USD): warn when the SIH project balance drops below this.
SIH_LOW_BALANCE_THRESHOLD="100"

# ============================================================
# Cron / webhooks
# ============================================================
# Bearer token required by every /api/cron/* route. Vercel Cron sends it as
# `Authorization: Bearer <CRON_SECRET>`. Generate a long random value.
CRON_SECRET=""

# ============================================================
# Transfermit — Payment provider
# ============================================================
TRANSFERMIT_API_KEY=""
TRANSFERMIT_WEBHOOK_SECRET=""

# ============================================================
# Telegram alerts (ops notifications; optional but recommended in prod)
# ============================================================
# Create a bot via @BotFather, then get the chat id you want alerts in.
ALERT_TELEGRAM_BOT_TOKEN=""
ALERT_TELEGRAM_CHAT_ID=""
